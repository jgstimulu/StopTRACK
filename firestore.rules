rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A aplicação já não usa o Firestore: os dados vivem no Supabase e são acedidos
    // apenas pelo servidor. Nega-se todo o acesso de clientes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
