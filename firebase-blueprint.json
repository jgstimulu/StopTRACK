{
  "entities": {
    "Stoppage": {
      "title": "Stoppage",
      "description": "Historical record of a machine downtime stoppage event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the stoppage record" },
        "machineId": { "type": "string", "description": "Code of the machine e.g. F01" },
        "machineName": { "type": "string", "description": "Human readable name of the machine" },
        "date": { "type": "string", "description": "Date formatted in Portuguese DD/MM/YYYY" },
        "startTime": { "type": "string", "description": "Start time string HH:mm:ss" },
        "endTime": { "type": "string", "description": "End time string HH:mm:ss" },
        "startTimestamp": { "type": "number", "description": "Unix epoch timestamp in milliseconds" },
        "endTimestamp": { "type": "number", "description": "Unix epoch timestamp in milliseconds" },
        "durationMs": { "type": "number", "description": "Total stoppage duration in milliseconds" },
        "durationFormatted": { "type": "string", "description": "Formatted duration string" },
        "shift": { "type": "string", "description": "Work shift e.g. 1º Turno" },
        "priority": { "type": "string", "description": "Priority level: Baixa, Média, Alta, Crítica" },
        "status": { "type": "string", "description": "Resolution status: Resolvido, Em Decorrer, Pendente" },
        "initiatedBy": { "type": "string", "description": "Name of operator who initiated the stoppage" },
        "closedBy": { "type": "string", "description": "Name of technician who closed the stoppage" },
        "stoppageType": { "type": "string", "description": "Classification type of the stoppage" },
        "stoppageDescription": { "type": "string", "description": "Description of the fault/stoppage" },
        "actionsTaken": { "type": "string", "description": "Description of corrective actions taken" },
        "otherObservations": { "type": "string", "description": "Optional follow-up notes" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" }
      },
      "required": ["id", "machineId", "startTimestamp", "endTimestamp", "durationMs"]
    },
    "Operator": {
      "title": "Operator",
      "description": "Plant operator or maintenance technician",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique operator ID" },
        "name": { "type": "string", "description": "Full name of the operator" },
        "role": { "type": "string", "description": "Role: Operador, Técnico de Manutenção, Supervisor, etc." },
        "canStart": { "type": "boolean", "description": "Whether authorized to start stoppages" },
        "canClose": { "type": "boolean", "description": "Whether authorized to close stoppages" },
        "active": { "type": "boolean", "description": "Whether currently active in the team" }
      },
      "required": ["id", "name"]
    },
    "StoppageType": {
      "title": "StoppageType",
      "description": "Standard stoppage classification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique stoppage type ID" },
        "name": { "type": "string", "description": "Name of the stoppage type" },
        "color": { "type": "string", "description": "Color tag" },
        "description": { "type": "string", "description": "Short explanation" },
        "active": { "type": "boolean", "description": "Active status" }
      },
      "required": ["id", "name"]
    },
    "ActiveDowntime": {
      "title": "ActiveDowntime",
      "description": "Currently active ongoing downtime being tracked",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Active downtime ID" },
        "machineId": { "type": "string", "description": "Machine code e.g. F01" },
        "machineName": { "type": "string", "description": "Machine name" },
        "startTimestamp": { "type": "number", "description": "Start timestamp in ms" },
        "startDateFormatted": { "type": "string", "description": "Formatted start date" },
        "startTimeFormatted": { "type": "string", "description": "Formatted start time" },
        "shift": { "type": "string", "description": "Work shift" },
        "initiatedBy": { "type": "string", "description": "Initiator name" },
        "currentLevel": { "type": "number", "description": "Current stage level (1, 2, or 3)" },
        "currentStage": { "type": "string", "description": "Current stage name" },
        "assignedTechnician": { "type": "string", "description": "Assigned technician" },
        "stageStartTimestamp": { "type": "number", "description": "Timestamp when current stage started" }
      },
      "required": ["id", "machineId", "startTimestamp"]
    }
  },
  "firestore": {
    "/stoppages/{stoppageId}": {
      "schema": "Stoppage",
      "description": "Historical stoppage events collection"
    },
    "/operators/{operatorId}": {
      "schema": "Operator",
      "description": "Maintenance team operators and technicians"
    },
    "/stoppageTypes/{typeId}": {
      "schema": "StoppageType",
      "description": "Configured stoppage categories"
    },
    "/activeDowntimes/{machineId}": {
      "schema": "ActiveDowntime",
      "description": "Active real-time running downtime per machine"
    }
  }
}
